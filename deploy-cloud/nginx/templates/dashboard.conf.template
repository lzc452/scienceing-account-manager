# 看板站点（由 nginx 官方镜像的 envsubst 机制从本模板生成到 /etc/nginx/conf.d/）
# 仅 ${DASHBOARD_HOST} 会被替换；$host / $uri 等 nginx 变量不受影响。
#
# DASHBOARD_HOST 既可以是域名（dashboard.example.com），也可以是公网 IP
# （134.175.156.233）。两种形态本文件无需改动 —— server_name 与证书路径都按字面值取。
# 走 IP 时证书为 Let's Encrypt 的 IP 证书（shortlived profile，6 天有效期），
# 路径同样是 /etc/letsencrypt/live/<IP>/。

# ── 80：只保留 ACME 校验与 301 跳转 ──
server {
    listen      80;
    listen      [::]:80;
    server_name ${DASHBOARD_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── 443：唯一业务入口 ──
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${DASHBOARD_HOST};

    ssl_certificate     /etc/letsencrypt/live/${DASHBOARD_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DASHBOARD_HOST}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DASHBOARD_HOST}/chain.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # 不配 ssl_stapling：Let's Encrypt 已于 2025-08-06 关停 OCSP 服务，
    # 其签发的证书不再包含 OCSP URL，开启 stapling 只会让 nginx 报
    # "no OCSP responder" 之类的告警，不产生任何实际效果。

    # 手册正文内联插图（data URL）经 JSON 上传，后端已放到 12mb，网关需同步放开
    client_max_body_size 12m;

    root  /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # SPA history 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API 反代到 app 容器（走 internal 网络，app 未发布端口）
    location /api/ {
        set $deploy_verification ${SCIENCEING_DEPLOY_VERIFY_ONLY};
        if ($uri = /api/extension/config) { set $deploy_verification 0; }
        if ($deploy_verification = 1) { return 503; }
        proxy_pass         http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        # 关键：后端 isSecureRequest() 依据它决定是否给会话 Cookie 加 Secure。
        # 漏了这一行，HTTPS 下 Cookie 仍不带 Secure，等于白上 TLS。
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    # 扩展分发包：缺失必须 404，不能回退 index.html，否则用户会下载到 HTML
    location /downloads/ {
        try_files $uri =404;
        location ~ \.zip$ {
            default_type application/zip;
            add_header Content-Disposition 'attachment';
            include /etc/nginx/snippets/security-headers.conf;
        }
    }

    # 构建产物长缓存（文件名带 hash）
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
}
