# 科应共享账号管理平台 —— 云服务器生产配置
# 部署到 /opt/scienceing/.env，权限必须 600，属主为执行部署的运维账号。
# 本文件是模板：复制为 .env 后逐项填写，**不要提交到 Git**。

# ══════════════════════════════════════════════════════════════
# 一、站点
# ══════════════════════════════════════════════════════════════
# 看板访问地址的主机部分。**可以是公网 IP，也可以是域名**，两种形态 nginx 模板与
# 证书脚本都自动适配，切换时只需改这一行 + 重签证书 + 重打扩展。
#
# 当前走「IP + Let's Encrypt IP 证书」路线：不需要域名、不需要 ICP 备案。
#   - IP 证书必须是 shortlived profile（6 天有效期），续期脚本已按此调整告警阈值
#   - 代价：用户访问要记 IP；IP 变更即失效；cron 一旦停摆 6 天内服务会断
#
# 将来切域名时（需先完成 ICP 备案）：把下面改成域名，重跑 issue-cert.sh 与
# patch-extension.mjs 即可。扩展 ID 不受影响（已由 key 固定），无需重新收敛来源。
DASHBOARD_HOST=134.175.156.233

# Let's Encrypt 证书到期提醒邮箱（签发时必填，收不到续期失败的告警就等于没有告警）
CERTBOT_EMAIL=ops@example.com

# ══════════════════════════════════════════════════════════════
# 二、运行环境（容器内路径，通常无需修改）
# ══════════════════════════════════════════════════════════════
NODE_ENV=production
TZ=Asia/Shanghai
PORT=3000

DATABASE_PATH=/data/scienceing.prod.db
SCIENCEING_BACKUP_DIR=/backups
EXTENSION_DOWNLOAD_DIR=/downloads
SCIENCING_STORAGE_STATE=/state/admin.json
SCIENCING_WORKER_CLI=/app/playwright/worker/dist/cli.js

# Worker 浏览器：Docker 内用 Playwright 自带 Chromium，不要用 chrome/msedge
SCIENCING_BROWSER_CHANNEL=chromium
SCIENCING_BROWSER_HEADLESS=true

# ══════════════════════════════════════════════════════════════
# 三、反向代理信任（必须与 docker-compose.yml 的 internal 子网一致）
# ══════════════════════════════════════════════════════════════
# 后端 main.ts 用 Express trust proxy 还原真实客户端 IP。
# 容器化后 nginx 不再是回环地址，若不设置此项，req.ip 会退化成 nginx 容器 IP，
# 导致所有用户共用同一个登录限流桶（10 次失败 = 全团队被锁 15 分钟）。
TRUST_PROXY=172.28.0.0/16

# ══════════════════════════════════════════════════════════════
# 四、密钥
# ══════════════════════════════════════════════════════════════
# AES-256-GCM 主密钥，64 位 hex。生成：openssl rand -hex 32
# ！！丢失后已入库的科应账号密码永久无法解密，务必离线备份到密码管理器 ！！
SCIENCEING_MASTER_KEY=

# 首次 db:seed 的管理员口令。seed 完成后请删除本行并重启。
ADMIN_INITIAL_PASSWORD=

# ══════════════════════════════════════════════════════════════
# 五、科应后台凭据（Worker 改密用；仅环境变量，绝不入库/入镜像/Git）
# ══════════════════════════════════════════════════════════════
SCIENCING_ADMIN_URL=https://www.scienceing.com/account/management/list

# 管理员邮箱固定为 lishenggao@highpowertech.com（科应后台只有一个管理员账号），不可改。
SCIENCING_ADMIN_USERNAME=lishenggao@highpowertech.com

# ⚠️ 必须用生产专用强密码，严禁与开发/测试环境相同。
# 该密码只在服务器 .env 中保存，绝不提交到 Git。
SCIENCING_ADMIN_PASSWORD=

# ══════════════════════════════════════════════════════════════
# 六、来源收敛（P0 修复项，必须显式配置）
# ══════════════════════════════════════════════════════════════
# 后端一旦检测到 CORS_ORIGINS 非空，就会**整体替换**默认白名单。
# 默认白名单里包含 chrome-extension:// 通配，替换后必须把扩展来源补回来，
# 否则扩展的 service worker 会被 CORS 拦死。
# 扩展 ID 由 deploy-cloud/scripts/patch-extension.mjs 输出（脚本会直接打印这两行）。
#
# 走 IP 路线时来源就是 https://<IP>（注意是 https，不是 http）。
CORS_ORIGINS=https://134.175.156.233,chrome-extension://opockgnmgpgocghdfanhlfcpkaahodga

# 扩展来源白名单（一次性领取证明校验用），多个用逗号分隔
SCIENCEING_EXTENSION_IDS=opockgnmgpgocghdfanhlfcpkaahodga

# ！！扩展签名私钥必须放在开发机仓库/发布目录外并离线备份；发版传 ExtensionKeyPath，持续复用 ！！
# 它决定扩展 ID。丢失后重新生成会得到新 ID，届时 CORS_ORIGINS 与上面的白名单都要改，
# 且所有同事必须重新安装扩展。该文件已被 .gitignore 覆盖，不会入库。

# ══════════════════════════════════════════════════════════════
# 七、部署验收自检凭据（verify-deploy.sh 用）
# ══════════════════════════════════════════════════════════════
# 验收脚本需要一组可登录凭据来测试 Cookie Secure 属性。
# 不填时验收会跳过该项（不影响功能，但建议配置以完成完整自检）。
# VERIFY_USERNAME=admin
# VERIFY_PASSWORD=

# ══════════════════════════════════════════════════════════════
# 八、可选调优
# ══════════════════════════════════════════════════════════════
# SCIENCING_WORKER_TIMEOUT_MS=180000
# SCIENCING_MAX_ATTEMPTS=3
# SCIENCING_RETRY_DELAY_MS=5000
# RECYCLE_INTERVAL_MS=15000
# RESET_INTERVAL_MS=10000
# SESSION_SWEEP_INTERVAL_MS=600000
