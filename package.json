{
  "name": "scienceing-account-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only=server",
    "dev:web": "node scripts/dev.mjs --only=web",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:rebuild": "node scripts/dev.mjs --rebuild",
    "test:dev-package": "node --test scripts/test/development-extension-package.test.mjs",
    "test:release-scripts": "node --test scripts/test/powershell-encoding.test.mjs",
    "test:deploy-gateway": "node --test scripts/test/gateway-resilience.test.mjs",
    "test:deploy-utils": "node --test scripts/test/deploy-utils.test.mjs",
    "test:db-doctor": "node --test scripts/test/db-doctor-target.test.mjs",
    "test:security-headers": "node --test scripts/test/security-headers.test.mjs",
    "test:account-crypto": "node --test scripts/test/account-password-crypto.test.mjs",
    "test:backend-invariants": "node --test scripts/test/backend-invariants.test.mjs",
    "db:migrate": "pnpm --filter @scienceing/server db:migrate",
    "db:seed": "pnpm --filter @scienceing/server db:seed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:shared": "pnpm --filter @scienceing/shared build"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
