{
  "name": "@scienceing/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "科应共享账号管理平台共享契约：枚举、系统设置键、API DTO、状态语义色映射",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./password-policy": {
      "types": "./password-policy.d.ts",
      "import": "./password-policy.cjs",
      "require": "./password-policy.cjs",
      "default": "./password-policy.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/password-policy.test.cjs"
  }
}
