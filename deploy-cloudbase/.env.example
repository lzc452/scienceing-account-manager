# CloudBase 云托管环境变量模板（复制到控制台「服务配置 → 环境变量」逐项填写）
#
# 安全红线：
#   · 本文件只描述「需要哪些变量」，真实值一律在控制台填写，禁止写进镜像 / Git。
#   · SCIENCEING_MASTER_KEY 一旦更换，库内已加密的科应账号密码将无法解密，必须重建数据库。

# ── 运行时（多数已在 Dockerfile 里给了默认值，这里列出以便核对）──────────
NODE_ENV=production
TZ=Asia/Shanghai
# 云托管会注入 PORT（与「监听端口」一致），无需手工设置；本地 docker run 时用 -e PORT=8080
# PORT=8080

# ── 数据持久化（必须与 CFS 挂载路径一致）────────────────────────────────
# 生产库必须叫 *.prod.db（db/config.ts 断言），且必须在应用目录之外。
DATABASE_PATH=/data/scienceing.prod.db
SCIENCEING_BACKUP_DIR=/backup
SCIENCEING_STORAGE_STATE=/data/state/admin.json

# CFS 是 NFS 协议：WAL 依赖 -shm 共享内存映射，SQLite 不支持，必须用 delete。
# 若把数据目录改到云硬盘/本地盘，可改回 wal。
SCIENCEING_SQLITE_JOURNAL=delete

# ── 首次部署开关（初始化完成后建议保留 ALLOW_DB_INIT=0）─────────────────
# 1 = 允许在库不存在时自动建库并写种子数据；0 = 库不存在直接拒绝启动（防误建空库覆盖现场）
ALLOW_DB_INIT=1
SEED_ON_INIT=1
# 首次初始化必需，且只在首次生效；之后请置空。至少 12 位，避免弱口令。
ADMIN_INITIAL_PASSWORD=
BACKUP_BEFORE_MIGRATE=1
RUN_MIGRATIONS=1
# 可选：确认 CFS 权限允许后降权运行
RUN_AS_NONROOT=0

# ── 必填密钥 ────────────────────────────────────────────────────────────
# 32 字节（64 个 hex 字符）。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意变量名是两个 E：SCIENCEING_MASTER_KEY
SCIENCEING_MASTER_KEY=

# ── 科应后台（Worker 改密用；只走环境变量，PRD §42）──────────────────────
SCIENCING_ADMIN_URL=https://www.scienceing.com
SCIENCING_ADMIN_USERNAME=
SCIENCING_ADMIN_PASSWORD=
SCIENCING_BROWSER_CHANNEL=chromium
SCIENCING_BROWSER_HEADLESS=true
SCIENCING_WORKER_TIMEOUT_MS=180000

# ── 反代与跨域 ──────────────────────────────────────────────────────────
# 云托管在容器前有平台网关：信任 1 跳，req.ip 取右起第一个 XFF（平台看到的真实来源）。
# 不要设成 true——那会采信客户端自带的伪造 XFF，登录限流会被绕过。
TRUST_PROXY=1
# 同源部署无需配置；仅当扩展或其它独立域名需要跨域调用时才填，逗号分隔。
# CORS_ORIGINS=

# ── 前端静态托管（Dockerfile 已内置，改目录时才需要覆盖）──────────────────
WEB_DIST_DIR=/app/apps/web/dist
EXTENSION_DOWNLOAD_DIR=/app/apps/web/dist/downloads
SCIENCING_WORKER_CLI=/app/playwright/worker/dist/cli.js
APP_VERSION=0.1.0
