# dependencies
node_modules/

# pnpm local store / cache / state
.pnpm-store/
.pnpm-cache/
.pnpm-state/

# build output
dist/
# 前端构建暂存目录（先构建到这里再同步进 dist，避免 Windows 文件锁导致半截产物）
dist-build/
*.tsbuildinfo

# 扩展 ZIP 打包产物
*.zip
/apps/web/public/downloads/

# environment / secrets（PRD §42 管理员凭据只走环境变量）
.env
.env.*
!.env.example

# Playwright 管理员认证状态（最高敏感，PRD §29）
playwright/.auth/

# Playwright Worker 运行日志（含账号名等运行信息，不入库）
playwright/.worker-logs/

# SQLite 数据库（PRD §55）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db.restore-*
*.db.failed-*
prod-schema*.json
*.dev.db*
*.prod.db*

# logs
logs/
*.log
backups/
backup/
secrets/
secret/
*.bak
*.backup
*.secret
*.pem
*.pfx
*.key

# OS / editor 杂项
.DS_Store
Thumbs.db
*.swp
.idea/

# 工作区辅助目录（AI 助手记忆 / 代码图谱缓存，不入库）
.workbuddy/
.codegraph/
.agent-teams/
.ai-memory/

# 内网部署运行时产物（可再生成，不入库；config.env 除外——如需共享配置请自行取舍）
deploy-lan/run/
deploy-lan/nginx-prefix/
deploy-lan/dist/
deploy-lan/extension-lan/

# 云端部署运行时产物（密钥/证书/制品/暂存一律不入库）
deploy-cloud/.env
deploy-cloud/certs/
deploy-cloud/release/
deploy-cloud/release.new/
deploy-cloud/release.prev/
deploy-cloud/.ext-staging/
deploy-cloud/current.json
deploy-cloud/current.env
deploy-cloud/rollback.json
deploy-cloud/deployment.pending.json*
deploy-cloud/.operations.lock
deploy-cloud/release.candidate-*/
deploy-cloud/release.previous-*/
deploy-cloud/release.failed-*/
deploy-cloud/ops.previous-*/
deploy-cloud/*.failed-*/
__pycache__/
# 扩展签名私钥（*.pem 已在上面统一忽略，这里显式再声明一次以防规则调整）
deploy-cloud/extension-key.pem

# 调试/验证用临时目录与脚本（不入库；此前误提交过，勿再 add）
/.tmp-deps/
.tmp-build-check/
dist-tmp-*/
.release-tmp/
*.copying-*
